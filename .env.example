# ============================================================
# CLEANVEE — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# Firebase Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional secured Cloud Function endpoint for Gemini analysis.
# The Gemini API key must remain in Secret Manager on the backend.
# VITE_GEMINI_FUNCTION_URL=https://REGION-PROJECT_ID.cloudfunctions.net/geminiAnalysis

# Optional: Firebase Emulator (for local development)
# VITE_USE_FIREBASE_EMULATOR=true
