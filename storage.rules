rules_version = '2';

// ============================================================
// CLEANVEE — Cloud Storage Security Rules
// Fix #144: Validate file types to prevent malware/exe uploads
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    
    // ---- Helper functions ----
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidImage() {
      // Must be an image type (jpeg, png, webp)
      return request.resource.contentType.matches('image/.*')
             // Prevent SVG uploads which can contain malicious JavaScript
             && !request.resource.contentType.matches('image/svg.*')
             // Max size 5MB
             && request.resource.size < 5 * 1024 * 1024;
    }
    
    function userAssignedToBuilding(buildingId) {
      return isAuthenticated() && buildingId in get(/databases/(default)/documents/users/$(request.auth.uid)).data.assigned_building_ids;
    }

    function checkpointBelongsToBuilding(checkpointId, buildingId) {
      return exists(/databases/(default)/documents/checkpoints/$(checkpointId)) &&
        get(/databases/(default)/documents/checkpoints/$(checkpointId)).data.building_id == buildingId;
    }

    match /proof_of_quality/{buildingId}/{checkpointId}/{fileName} {
      allow read: if userAssignedToBuilding(buildingId) && checkpointBelongsToBuilding(checkpointId, buildingId);
      allow create: if userAssignedToBuilding(buildingId) &&
        checkpointBelongsToBuilding(checkpointId, buildingId) &&
        request.resource.metadata.uploaderId == request.auth.uid &&
        isValidImage();
      allow update, delete: if false;
    }
    
    match /avatars/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if request.auth.uid == userId && isValidImage();
      allow delete: if request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
